{
  "manifest_version": 2,
  "name": "Smart Tags for Zotero",
  "version": "0.2.1",
  "description": "An approved tag vocabulary, evidence-backed suggestions, custom topics, and reversible cleanup.",
  "author": "Smart Tags contributors",
  "applications": {
    "zotero": {
      "id": "smart-tags@zotero-local.org",
      "update_url": "https://raw.githubusercontent.com/leviyuli/ZTagging/main/updates.json",
      "strict_min_version": "10.0.6",
      "strict_max_version": "10.0.*"
    }
  },
  "icons": { "48": "content/icon.svg", "96": "content/icon.svg" }
}
